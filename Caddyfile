dev.oneblock.vn {
	encode zstd gzip
	reverse_proxy 103.82.133.178:8100
}

# ==============================
# dashboard.oneblock.vn (customer)
# ==============================
dashboard.oneblock.vn {
	encode zstd gzip
	# request_body { max_size 100MB }

	# All paths go to :9000 (including /api and /auth/callback)
	handle {
		reverse_proxy 103.82.133.178:9000
	}
}

portainer.oneblock.vn {
	encode zstd gzip

	reverse_proxy https://portainer:9443 {
		# pass the original Host (optional but nice)
		header_up Host {host}

		# Portainer's built-in cert is self-signed → skip verify
		transport http {
			tls_insecure_skip_verify
		}
	}
}

